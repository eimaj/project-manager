{
  "_comment": "pm personal config (schema v2). pm-generate renders this to ~/.config/pm/config.json (gitignored). `tools` is a user-defined map: each key is a tool name you choose, each value maps that name to a concrete `provider` (MCP/CLI/skill id), an optional output `root` (multiple tools may share one), and optional related `skills[]`. Skills address tools BY NAME and degrade when `provider` is \"none\"/blank. `version` + `paths` are reserved framework keys, not tools.",
  "version": "2.0",
  "paths": {
    "framework_root": "~/.claude/pm",
    "notes_root": "~/pm-notes"
  },
  "tools": {
    "meetings": {
      "provider": "granola",
      "root": "~/pm-notes/meetings",
      "skills": ["notes-import", "meeting-summary", "meeting-catchup"]
    },
    "calendar": {
      "provider": "ms365-calendar",
      "skills": ["morning-briefing"]
    },
    "email": {
      "provider": "ms365-outlook",
      "root": "~/pm-notes",
      "skills": ["email-triage", "inbox-sweep", "morning-briefing"]
    },
    "tasks": {
      "provider": "linear",
      "skills": ["task-triage", "project-update", "todoapp-sync", "epic-status"]
    },
    "github": {
      "provider": "gh",
      "skills": ["pr-review", "open-pr", "pr-watch", "branch-diff"]
    },
    "todo": {
      "provider": "todoApp",
      "root": "~/pm-notes/todos",
      "skills": ["todoapp-cli", "todoapp-journal", "todoapp-sync"]
    },
    "logs": {
      "provider": "logTool",
      "root": "~/pm-notes/logs",
      "skills": ["logtool", "logtool-sweep", "logtool-day", "logtool-week", "logtool-search"]
    },
    "notes": {
      "provider": "filesystem",
      "root": "~/pm-notes",
      "skills": []
    }
  }
}
